---
// Page affichée après un envoi réussi sans JavaScript.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
---

<BaseLayout title="Message envoyé" description="Votre message a bien été envoyé." noindex>
  <Hero eyebrow="Contact" title="Merci, votre message est bien parti !" />
  <Section narrow>
    <div class="stack">
      <p class="lead">Nous revenons vers vous sous 48 h ouvrées.</p>
      <Button href="/">Retour à l’accueil</Button>
    </div>
  </Section>
</BaseLayout>
