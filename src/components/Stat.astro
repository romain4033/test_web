---
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---

<div class="stat">
  <dt class="stat__label">{label}</dt>
  <dd class="stat__value">{value}</dd>
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column-reverse; /* valeur affichée au-dessus, ordre sémantique dt/dd conservé */
    gap: var(--space-2);
    padding-left: var(--space-4);
    border-left: 4px solid var(--color-accent);
  }
  .stat__value {
    margin: 0;
    font-size: var(--fs-2xl);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .stat__label {
    font-weight: 500;
    color: var(--color-muted);
  }
  :global(.on-dark) .stat__label {
    color: var(--color-on-dark-muted);
  }
</style>
