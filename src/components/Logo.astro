---
import { SITE } from '../data/site';
---

<span class="logo">
  <svg class="logo__mark" viewBox="0 0 32 32" width="36" height="36" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="8" fill="#FF6B1A"></rect>
    <path d="M9 23 16 9l7 14h-4l-3-6-3 6z" fill="#111827"></path>
  </svg>
  <span class="logo__text">{SITE.name}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 800;
    font-size: var(--fs-md);
    letter-spacing: -0.02em;
  }
</style>
